# ── Canonical host + clean URLs ────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS + www (canonical host). Preserves query string.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]
  # If already https but bare domain, rewrite host only
  RewriteCond %{HTTP_HOST} ^nejstudios\.com$ [NC]
  RewriteRule ^ https://www.nejstudios.com%{REQUEST_URI} [L,R=301,NE]

  # Redirect /foo.html → /foo (strip .html from direct requests)
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301,NE]

  # Redirect /index → /  (home canonical)
  RewriteRule ^index/?$ / [L,R=301,NE]

  # Internally rewrite extensionless requests to .html files
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L,QSA]
</IfModule>

# ── Cache Control ──────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — always revalidate
  ExpiresByType text/html                  "access plus 0 seconds"

  # CSS & JS — 1 year (busted by ?v= query string)
  ExpiresByType text/css                   "access plus 1 year"
  ExpiresByType application/javascript     "access plus 1 year"
  ExpiresByType text/javascript            "access plus 1 year"

  # Images — 1 month
  ExpiresByType image/jpeg                 "access plus 1 month"
  ExpiresByType image/png                  "access plus 1 month"
  ExpiresByType image/webp                 "access plus 1 month"
  ExpiresByType image/svg+xml              "access plus 1 month"
  ExpiresByType image/gif                  "access plus 1 month"
  ExpiresByType image/x-icon              "access plus 1 year"

  # Fonts
  ExpiresByType font/woff2                 "access plus 1 year"
  ExpiresByType font/woff                  "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # HTML — no cache store
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # CSS/JS — cache but revalidate (ETag handles actual freshness)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
